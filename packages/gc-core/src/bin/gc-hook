#!/usr/bin/env bash
# gc-hook -- Hook handler for GlobalContext
# Handles PreCompact (eager projection build) and SessionStart (context injection).
# Part of Story 05, Tasks 14 and 15.
set -euo pipefail

# ---------------------------------------------------------------------------
# Resolve project root and source dependencies
# ---------------------------------------------------------------------------
_GC_HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_GC_LIB_DIR="$(cd "$_GC_HOOK_DIR/../lib" && pwd)"

# shellcheck source=../lib/paths.sh
source "$_GC_LIB_DIR/paths.sh"
# shellcheck source=../lib/context_loader.sh
source "$_GC_LIB_DIR/context_loader.sh"
# shellcheck source=../lib/format_context.sh
source "$_GC_LIB_DIR/format_context.sh"
# shellcheck source=../lib/session_resolve.sh
source "$_GC_LIB_DIR/session_resolve.sh"
# shellcheck source=../lib/latest_symlink.sh
source "$_GC_LIB_DIR/latest_symlink.sh"

# ---------------------------------------------------------------------------
# PreCompact hook (Task 14)
# ---------------------------------------------------------------------------
# Called before compaction. Eagerly builds context.json projection so it's
# ready when SessionStart fires post-compaction.
handle_precompact() {
  local project_id="${1:-}"
  local session_id="${2:-}"

  if [[ -z "$project_id" || -z "$session_id" ]]; then
    echo "gc-hook precompact: project_id and session_id required" >&2
    return 0  # Don't fail the hook
  fi

  # Build context projection eagerly
  build_context_if_needed "$project_id" "$session_id" 2>/dev/null || {
    echo "gc-hook precompact: projection build failed (non-fatal)" >&2
  }

  return 0
}

# ---------------------------------------------------------------------------
# SessionStart hook (Task 15)
# ---------------------------------------------------------------------------
# Called when a new session starts. If source is "compact" or "clear",
# injects context from the previous session as additionalContext.
handle_sessionstart() {
  local project_id="${1:-}"
  local session_id="${2:-}"
  local source_type="${3:-manual}"
  local previous_session_id="${4:-}"

  case "$source_type" in
    compact)
      _inject_context "$project_id" "$previous_session_id" "## Context Recovery (Auto)"
      return $?
      ;;
    clear)
      _inject_context "$project_id" "$previous_session_id" "## Context Recovery (Cleared)" \
        "Previous conversation was cleared by user."
      return $?
      ;;
    resume)
      # Skip for initial implementation
      echo '{}'
      return 0
      ;;
    *)
      # manual or unknown: no injection
      echo '{}'
      return 0
      ;;
  esac
}

# _inject_context(project_id, previous_session_id, heading, [note])
#
# Loads previous session context, formats as markdown, and returns
# as {"additionalContext": "..."} JSON.
_inject_context() {
  local project_id="$1"
  local prev_sid="$2"
  local heading="$3"
  local note="${4:-}"

  # If no previous session ID provided, try the latest symlink
  if [[ -z "$prev_sid" ]]; then
    prev_sid="$(resolve_latest_session "$project_id" 2>/dev/null)" || {
      _inject_fallback
      return 0
    }
  fi

  # Load context
  local context
  context="$(load_context "$project_id" "$prev_sid" 2>/dev/null)" || {
    _inject_fallback
    return 0
  }

  # Format as compact markdown
  local md_content
  md_content="$(printf '%s' "$context" | format_markdown 2>/dev/null)" || {
    _inject_fallback
    return 0
  }

  local full_content="${heading}"$'\n\n'
  if [[ -n "$note" ]]; then
    full_content="${full_content}${note}"$'\n\n'
  fi
  full_content="${full_content}${md_content}"

  # Truncate to 50KB if needed
  local max_size=51200
  if [[ ${#full_content} -gt $max_size ]]; then
    full_content="${full_content:0:$max_size}"$'\n\n'"*[Context truncated due to size limit]*"
  fi

  # Output as JSON
  jq -n --arg ctx "$full_content" '{"additionalContext": $ctx}'
}

# _inject_fallback()
#
# Returns a fallback additionalContext when context loading fails.
_inject_fallback() {
  jq -n '{"additionalContext": "## Context Recovery\n\nNote: Unable to load previous session context. Use `gc-query last` to retrieve it manually."}'
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
main() {
  local hook_type="${1:-}"
  shift || true

  case "$hook_type" in
    precompact)   handle_precompact "$@" ;;
    sessionstart) handle_sessionstart "$@" ;;
    --help|-h)
      echo "Usage: gc-hook <hook-type> [args...]"
      echo ""
      echo "Hook types:"
      echo "  precompact <project-id> <session-id>"
      echo "  sessionstart <project-id> <session-id> <source> [previous-session-id]"
      return 0
      ;;
    *)
      echo "gc-hook: unknown hook type '$hook_type'" >&2
      return 1
      ;;
  esac
}

main "$@"

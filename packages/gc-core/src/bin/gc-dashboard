#!/usr/bin/env node
// gc-dashboard -- Web UI dashboard for GlobalContext event monitoring.
// Single-file Node.js HTTP server (no npm). Serves inline HTML/CSS/JS dashboard.
// Uses SSE for live event streaming. Imports existing projection libs.
//
// Usage: gc-dashboard [--port PORT]
// Default port: 4000

import http from 'node:http';
import https from 'node:https';
import { readdir, readFile, writeFile, stat } from 'node:fs/promises';
import { createReadStream } from 'node:fs';
import { createInterface } from 'node:readline';
import path from 'node:path';
import os from 'node:os';

// --- Inlined helpers (from projections/lib) ---
// Self-contained so the dashboard works from any install location.

function getBasePath() {
  return process.env.CLAUDE_CONTEXT_PATH || path.join(os.homedir(), '.claude-context');
}

function truncate(str, maxLen, suffix = '...') {
  if (typeof str !== 'string') return '';
  if (str.length <= maxLen) return str;
  return str.slice(0, maxLen) + suffix;
}

/** Escape HTML entities for safe embedding in generated HTML */
function escHtml(s) {
  if (typeof s !== 'string') return '';
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

/** Format a file path: dim directory, bright filename */
function fmtPath(filePath) {
  if (!filePath) return '<span class="ev-file">?</span>';
  const parts = filePath.split('/');
  // Show last 3 segments if path is long
  const display = parts.length > 4 ? ['...', ...parts.slice(-3)] : parts;
  const dir = display.slice(0, -1).join('/');
  const file = display[display.length - 1];
  if (dir) {
    return '<span class="ev-file"><span class="ev-file-dir">' + escHtml(dir) + '/</span><span class="ev-file-name">' + escHtml(file) + '</span></span>';
  }
  return '<span class="ev-file"><span class="ev-file-name">' + escHtml(file) + '</span></span>';
}

/** Format a short domain from a URL */
function fmtDomain(url) {
  try {
    const u = new URL(url);
    return u.hostname.replace(/^www\./, '');
  } catch { return url; }
}

function generateInputSummary(toolName, toolInput) {
  if (!toolInput) return { text: `${toolName}: (no input)`, html: escHtml(toolName) + ': <span class="ev-output">(no input)</span>' };
  const name = (toolName || '').toLowerCase();
  switch (name) {
    case 'read':
      return {
        text: `Read ${toolInput.file_path || '?'}`,
        html: '<span class="ev-icon">&#128196;</span> ' + fmtPath(toolInput.file_path)
      };
    case 'write': {
      const len = (toolInput.content || '').length;
      return {
        text: `Write ${toolInput.file_path || '?'} (${len} chars)`,
        html: '<span class="ev-icon">&#9998;</span> ' + fmtPath(toolInput.file_path) + ' <span class="ev-output">(' + len + ' chars)</span>'
      };
    }
    case 'edit':
      return {
        text: `Edit ${toolInput.file_path || '?'}`,
        html: '<span class="ev-icon">&#128221;</span> ' + fmtPath(toolInput.file_path) +
          (toolInput.old_string || toolInput.new_string ?
            ' <span class="ev-diff"><span class="ev-diff-del">-' + escHtml(String((toolInput.old_string || '').split('\n').length)) + '</span> <span class="ev-diff-add">+' + escHtml(String((toolInput.new_string || '').split('\n').length)) + '</span> lines</span>'
            : '')
      };
    case 'bash': {
      const cmd = toolInput.command || '';
      const desc = toolInput.description || '';
      return {
        text: `Bash: ${truncate(cmd, 100)}`,
        html: '<div class="ev-bash"><span class="ev-bash-prompt">$</span> <code>' + escHtml(truncate(cmd, 200)) + '</code></div>' +
          (desc ? '<div class="ev-output">' + escHtml(truncate(desc, 120)) + '</div>' : '')
      };
    }
    case 'glob':
      return {
        text: `Glob ${toolInput.pattern || '?'} in ${toolInput.path || '.'}`,
        html: '<span class="ev-icon">&#128269;</span> <span class="ev-search">' + escHtml(toolInput.pattern || '?') + '</span>' +
          ' <span class="ev-output">in ' + escHtml(truncate(toolInput.path || '.', 60)) + '</span>'
      };
    case 'grep':
      return {
        text: `Grep ${truncate(toolInput.pattern || '?', 50)} in ${toolInput.path || '.'}`,
        html: '<span class="ev-icon">&#128269;</span> <span class="ev-search">' + escHtml(truncate(toolInput.pattern || '?', 80)) + '</span>' +
          ' <span class="ev-output">in ' + escHtml(truncate(toolInput.path || '.', 60)) + '</span>' +
          (toolInput.output_mode ? ' <span class="ev-code">' + escHtml(toolInput.output_mode) + '</span>' : '')
      };
    case 'webfetch': {
      const url = toolInput.url || '?';
      const domain = fmtDomain(url);
      return {
        text: `WebFetch ${truncate(url, 80)}`,
        html: '<span class="ev-web-icon">&#127760;</span> <a class="ev-web-link" href="' + escHtml(url) + '" target="_blank" rel="noopener">' + escHtml(domain) + '</a>' +
          (toolInput.prompt ? ' <span class="ev-output">' + escHtml(truncate(toolInput.prompt, 80)) + '</span>' : '')
      };
    }
    case 'websearch':
      return {
        text: `WebSearch ${truncate(toolInput.query || '?', 80)}`,
        html: '<span class="ev-web-icon">&#128270;</span> <em class="ev-web-query">' + escHtml(truncate(toolInput.query || '?', 120)) + '</em>'
      };
    case 'task':
      return {
        text: `Task: ${truncate(toolInput.description || toolInput.prompt || '?', 100)}`,
        html: '<div class="ev-task"><span class="ev-task-icon">&#129302;</span> ' +
          (toolInput.subagent_type ? '<span class="ev-task-agent-badge">' + escHtml(toolInput.subagent_type) + '</span> ' : '') +
          '<span class="ev-output">' + escHtml(truncate(toolInput.description || toolInput.prompt || '?', 150)) + '</span>' +
          (toolInput.run_in_background ? ' <span class="ev-task-bg-badge">bg</span>' : '') +
          '</div>'
      };
    case 'taskcreate':
      return {
        text: `New task: ${toolInput.subject || '?'}`,
        html: '<div class="ev-task"><span class="ev-task-icon">&#9989;</span> New task: <strong>' + escHtml(truncate(toolInput.subject || '?', 120)) + '</strong>' +
          (toolInput.description ? ' <span class="ev-output">' + escHtml(truncate(toolInput.description, 100)) + '</span>' : '') +
          '</div>'
      };
    case 'taskupdate': {
      const statusBadgeClass = { completed: 'ev-task-status-completed', in_progress: 'ev-task-status-inprogress', deleted: 'ev-task-status-deleted', pending: 'ev-task-status-pending' };
      const statusCls = statusBadgeClass[toolInput.status] || 'ev-task-status-pending';
      return {
        text: `Task ${toolInput.taskId || '?'} -> ${toolInput.status || '?'}`,
        html: '<div class="ev-task"><span class="ev-task-icon">&#128203;</span> ' + escHtml(toolInput.taskId || '?') +
          ' <span class="ev-task-status ' + statusCls + '">' + escHtml(toolInput.status || '?') + '</span>' +
          (toolInput.subject ? ' <span class="ev-output">' + escHtml(truncate(toolInput.subject, 100)) + '</span>' : '') +
          '</div>'
      };
    }
    case 'taskoutput':
      return {
        text: `Reading task output: ${toolInput.task_id || '?'}`,
        html: '<div class="ev-task"><span class="ev-task-icon">&#128228;</span> Reading task output: <span class="ev-code">' + escHtml(toolInput.task_id || '?') + '</span></div>'
      };
    case 'taskstop':
      return {
        text: `Stopping task: ${toolInput.task_id || '?'}`,
        html: '<div class="ev-task"><span class="ev-task-icon">&#9209;</span> Stopping task: <span class="ev-code">' + escHtml(toolInput.task_id || '?') + '</span></div>'
      };
    case 'tasklist':
      return {
        text: 'Listing tasks',
        html: '<div class="ev-task"><span class="ev-task-icon">&#128203;</span> Listing tasks</div>'
      };
    default:
      return {
        text: `${toolName}: ${truncate(JSON.stringify(toolInput), 100)}`,
        html: escHtml(toolName) + ': <span class="ev-output">' + escHtml(truncate(JSON.stringify(toolInput), 150)) + '</span>'
      };
  }
}

function generateOutputSummary(toolName, toolResponse, data) {
  const name = (toolName || '').toLowerCase();
  const response = typeof toolResponse === 'string' ? toolResponse : JSON.stringify(toolResponse || '');
  switch (name) {
    case 'read': {
      const lineCount = (response.match(/\n/g) || []).length + 1;
      return {
        text: `Read ${lineCount} lines`,
        html: '<span class="ev-icon">&#128196;</span> <span class="ev-output">Read ' + lineCount + ' lines</span>'
      };
    }
    case 'write':
      return {
        text: 'Write completed',
        html: '<span class="ev-icon">&#9998;</span> <span class="ev-output ev-success">Write completed</span>'
      };
    case 'edit':
      return {
        text: 'Edit completed',
        html: '<span class="ev-icon">&#128221;</span> <span class="ev-output ev-success">Edit completed</span>'
      };
    case 'bash': {
      const exitCode = data?.exit_code ?? data?.exitCode ?? '?';
      const stdout = data?.stdout || '';
      const stderr = data?.stderr || '';
      const exitInt = parseInt(exitCode, 10);
      const exitBadge = exitInt !== 0
        ? ' <span class="ev-exit-err">exit ' + escHtml(String(exitCode)) + '</span>'
        : ' <span class="ev-exit-ok">exit 0</span>';
      let outputPreview = '';
      if (stderr && exitInt !== 0) {
        outputPreview = '<div class="ev-bash-output ev-bash-stderr">' + escHtml(truncate(stderr, 200)) + '</div>';
      } else if (stdout) {
        outputPreview = '<div class="ev-bash-output">' + escHtml(truncate(stdout, 200)) + '</div>';
      } else if (response && typeof toolResponse === 'string') {
        outputPreview = '<div class="ev-bash-output">' + escHtml(truncate(response, 200)) + '</div>';
      }
      return {
        text: `Bash exit=${exitCode}: ${truncate(stdout || response, 80)}`,
        html: '<div class="ev-bash-result"><span class="ev-bash-prompt">$</span>' + exitBadge + '</div>' + outputPreview
      };
    }
    case 'glob': {
      const count = response.split('\n').filter(l => l.trim()).length;
      return {
        text: `Glob: ${count} files`,
        html: '<span class="ev-icon">&#128269;</span> <span class="ev-search-result">' + count + ' files matched</span>'
      };
    }
    case 'grep': {
      const count = response.split('\n').filter(l => l.trim()).length;
      return {
        text: `Grep: ${count} results`,
        html: '<span class="ev-icon">&#128269;</span> <span class="ev-search-result">' + count + ' results</span>'
      };
    }
    case 'websearch': {
      let resultsHtml = '';
      if (toolResponse && typeof toolResponse === 'object') {
        const results = toolResponse.results || toolResponse;
        if (Array.isArray(results)) {
          const top = results.slice(0, 3);
          resultsHtml = '<div class="ev-web-results">' +
            top.map(r => {
              const title = escHtml(truncate(r.title || r.url || '?', 60));
              const url = escHtml(r.url || '#');
              return '<a class="ev-web-result-item" href="' + url + '" target="_blank" rel="noopener">' + title + '</a>';
            }).join('') +
            (results.length > 3 ? '<span class="ev-output">+' + (results.length - 3) + ' more</span>' : '') +
            '</div>';
        }
      }
      return {
        text: `WebSearch: ${truncate(response, 100)}`,
        html: '<span class="ev-web-icon">&#128270;</span> <span class="ev-output">Search complete</span>' + resultsHtml
      };
    }
    case 'webfetch': {
      const code = (toolResponse && typeof toolResponse === 'object') ? toolResponse.code : '';
      const result = (toolResponse && typeof toolResponse === 'object') ? (toolResponse.result || '') : response;
      const byteCount = typeof result === 'string' ? result.length : 0;
      return {
        text: `WebFetch: ${code || '?'} (${byteCount} bytes)`,
        html: '<span class="ev-web-icon">&#127760;</span>' +
          (code ? ' <span class="ev-code">HTTP ' + escHtml(String(code)) + '</span>' : '') +
          ' <span class="ev-output">' + byteCount + ' chars fetched</span>'
      };
    }
    case 'task': {
      const preview = truncate(response, 200);
      return {
        text: `Task completed: ${truncate(response, 100)}`,
        html: '<div class="ev-task"><span class="ev-task-icon">&#129302;</span> <span class="ev-output ev-success">Task completed</span>' +
          (preview ? '<div class="ev-bash-output">' + escHtml(preview) + '</div>' : '') +
          '</div>'
      };
    }
    case 'taskcreate':
      return {
        text: 'Task created',
        html: '<div class="ev-task"><span class="ev-task-icon">&#9989;</span> <span class="ev-output ev-success">Task created</span></div>'
      };
    case 'taskupdate':
      return {
        text: 'Task updated',
        html: '<div class="ev-task"><span class="ev-task-icon">&#128203;</span> <span class="ev-output ev-success">Task updated</span></div>'
      };
    case 'taskoutput': {
      const outPreview = truncate(response, 200);
      return {
        text: `Task output: ${truncate(response, 100)}`,
        html: '<div class="ev-task"><span class="ev-task-icon">&#128228;</span> <span class="ev-output">Task output received</span>' +
          (outPreview ? '<div class="ev-bash-output">' + escHtml(outPreview) + '</div>' : '') +
          '</div>'
      };
    }
    case 'taskstop':
      return {
        text: 'Task stopped',
        html: '<div class="ev-task"><span class="ev-task-icon">&#9209;</span> <span class="ev-output">Task stopped</span></div>'
      };
    case 'tasklist': {
      const listPreview = truncate(response, 200);
      return {
        text: `Task list: ${truncate(response, 100)}`,
        html: '<div class="ev-task"><span class="ev-task-icon">&#128203;</span> <span class="ev-output">Tasks listed</span>' +
          (listPreview ? '<div class="ev-bash-output">' + escHtml(listPreview) + '</div>' : '') +
          '</div>'
      };
    }
    default:
      return {
        text: `${toolName}: ${truncate(response, 100)}`,
        html: escHtml(toolName) + ': <span class="ev-output">' + escHtml(truncate(response, 150)) + '</span>'
      };
  }
}

function generateEventSummary(event) {
  const data = event.data || {};
  switch (event.event_type) {
    case 'SessionStarted':
      return {
        text: `Session started (model: ${data.model || '?'}, cwd: ${data.cwd || '?'})`,
        html: '<span class="ev-session-icon">&#9654;</span> <span class="ev-code">' + escHtml(data.model || '?') + '</span> <span class="ev-output">cwd: ' + escHtml(truncate(data.cwd || '?', 80)) + '</span>'
      };
    case 'SessionEnded':
      return {
        text: 'Session ended',
        html: '<span class="ev-session-icon">&#9632;</span> <span class="ev-output">Session ended</span>'
      };
    case 'UserPromptReceived': {
      const prompt = data.prompt || data.message || '';
      const trimmedPrompt = prompt.trimStart();
      // Detect system-injected messages by XML tag prefix
      if (trimmedPrompt.startsWith('<task-notification>')) {
        // Parse task notification: extract task-id, status, summary
        const tidMatch = trimmedPrompt.match(/<task-id>\s*(.*?)\s*<\/task-id>/s);
        const statusMatch = trimmedPrompt.match(/<status>\s*(.*?)\s*<\/status>/s);
        const summaryMatch = trimmedPrompt.match(/<summary>\s*(.*?)\s*<\/summary>/s);
        const tid = tidMatch ? tidMatch[1].trim() : '?';
        const tStatus = statusMatch ? statusMatch[1].trim() : '?';
        const tSummary = summaryMatch ? summaryMatch[1].trim() : '';
        const statusBadgeCls = tStatus === 'completed' ? 'ev-systask-status-completed'
          : tStatus === 'in_progress' ? 'ev-systask-status-inprogress'
          : tStatus === 'error' || tStatus === 'failed' ? 'ev-systask-status-failed'
          : 'ev-systask-status-other';
        return {
          text: `[System] Task notification: ${tid} ${tStatus}`,
          html: '<div class="ev-sysmsg ev-sysmsg-task">' +
            '<span class="ev-sysmsg-icon">&#129302;</span> ' +
            '<span class="ev-sysmsg-label">Task</span> ' +
            '<span class="ev-code">' + escHtml(truncate(tid, 20)) + '</span> ' +
            '<span class="ev-systask-status ' + statusBadgeCls + '">' + escHtml(tStatus) + '</span>' +
            (tSummary ? ' <span class="ev-output">' + escHtml(truncate(tSummary, 150)) + '</span>' : '') +
            '</div>'
        };
      }
      if (trimmedPrompt.startsWith('<system-reminder>')) {
        const previewText = trimmedPrompt.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
        return {
          text: `[System] Reminder: ${truncate(previewText, 150)}`,
          html: '<div class="ev-sysmsg ev-sysmsg-reminder">' +
            '<span class="ev-sysmsg-icon">&#9881;</span> ' +
            '<span class="ev-sysmsg-label">System Reminder</span> ' +
            '<span class="ev-output">' + escHtml(truncate(previewText, 200)) + '</span>' +
            '</div>'
        };
      }
      if (trimmedPrompt.startsWith('<task-id>') || trimmedPrompt.startsWith('<output-file>') ||
          trimmedPrompt.startsWith('<command-name>') || trimmedPrompt.startsWith('<command-message>')) {
        const tagMatch = trimmedPrompt.match(/^<([a-z-]+)>/);
        const tagName = tagMatch ? tagMatch[1] : 'system';
        const innerText = trimmedPrompt.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
        return {
          text: `[System] ${tagName}: ${truncate(innerText, 150)}`,
          html: '<div class="ev-sysmsg ev-sysmsg-meta">' +
            '<span class="ev-sysmsg-icon">&#9881;</span> ' +
            '<span class="ev-sysmsg-label">' + escHtml(tagName) + '</span> ' +
            '<span class="ev-output">' + escHtml(truncate(innerText, 200)) + '</span>' +
            '</div>'
        };
      }
      // Real user prompt
      return {
        text: `User: ${truncate(prompt, 200)}`,
        html: '<span class="ev-prompt-icon">&#128172;</span> <span class="ev-prompt">' + escHtml(truncate(prompt, 300)) + '</span>'
      };
    }
    case 'ToolCallRequested':
      return generateInputSummary(data.tool_name, data.tool_input);
    case 'ToolCallCompleted':
      return generateOutputSummary(data.tool_name, data.tool_response || data.result, data);
    case 'ToolCallFailed':
      return {
        text: `FAILED ${data.tool_name || '?'}: ${truncate(data.error || '', 150)}`,
        html: '<div class="ev-error"><span class="ev-error-icon">&#10060;</span> <strong>' + escHtml(data.tool_name || '?') + '</strong>: ' + escHtml(truncate(data.error || '', 200)) + '</div>'
      };
    case 'AgentSpawned':
      return {
        text: `Spawned ${data.agent_type || '?'}: ${truncate(data.description || '', 100)}`,
        html: '<span class="ev-agent-icon">&#129302;</span> <span class="ev-code">' + escHtml(data.agent_type || '?') + '</span>' +
          (data.agent_id ? ' <span class="ev-output">#' + escHtml(truncate(data.agent_id, 12)) + '</span>' : '') +
          (data.description ? ' <span class="ev-output">' + escHtml(truncate(data.description, 100)) + '</span>' : '')
      };
    case 'AgentCompleted':
      return {
        text: `Agent done: ${data.agent_type || '?'}`,
        html: '<span class="ev-agent-icon">&#129302;</span> <span class="ev-code">' + escHtml(data.agent_type || '?') + '</span> <span class="ev-output ev-success">completed</span>' +
          (data.agent_id ? ' <span class="ev-output">#' + escHtml(truncate(data.agent_id, 12)) + '</span>' : '')
      };
    case 'TurnCompleted': {
      const resp = data.response || '';
      return {
        text: 'Turn completed' + (resp ? ': ' + truncate(resp, 100) : ''),
        html: '<span class="ev-output">Turn completed</span>' +
          (resp ? '<div class="ev-turn-preview">' + escHtml(truncate(resp, 200)) + '</div>' : '')
      };
    }
    case 'CompactionTriggered':
      return {
        text: `COMPACTION at seq ${event.sequence}`,
        html: '<span class="ev-compact-icon">&#9888;</span> <span class="ev-compact">Compaction triggered</span>' +
          (data.trigger ? ' <span class="ev-output">' + escHtml(data.trigger) + '</span>' : '')
      };
    default:
      return {
        text: `${event.event_type} at seq ${event.sequence}`,
        html: escHtml(event.event_type) + ' <span class="ev-output">seq ' + (event.sequence || '') + '</span>'
      };
  }
}

// --- CLI args ---
import { writeFileSync, unlinkSync, readFileSync, existsSync } from 'node:fs';
import { execSync } from 'node:child_process';

let port = 4000;
let command = 'start'; // default

const args = process.argv.slice(2);
for (let i = 0; i < args.length; i++) {
  if (args[i] === '--port' && args[i + 1]) {
    port = parseInt(args[i + 1], 10);
    i++;
  } else if (args[i] === '--help' || args[i] === 'help') {
    console.log('Usage: gc-dashboard [command] [--port PORT]');
    console.log('');
    console.log('Commands:');
    console.log('  start      Start the dashboard (default)');
    console.log('  stop       Stop the running dashboard');
    console.log('  restart    Stop + start (for updates)');
    console.log('  status     Show if dashboard is running');
    console.log('');
    console.log('Options:');
    console.log('  --port PORT  HTTP port (default: 4000)');
    process.exit(0);
  } else if (['start', 'stop', 'restart', 'status'].includes(args[i])) {
    command = args[i];
  }
}

const BASE = getBasePath();
const EVENTS_DIR = path.join(BASE, 'events');
const PID_FILE = path.join(BASE, '.dashboard.pid');

// --- Lifecycle commands ---

function readPid() {
  try {
    const content = readFileSync(PID_FILE, 'utf-8').trim();
    const [pidStr, portStr] = content.split('\n');
    return { pid: parseInt(pidStr, 10), port: parseInt(portStr, 10) || 4000 };
  } catch {
    return null;
  }
}

function isRunning(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

function stopDashboard() {
  const info = readPid();
  if (!info || !isRunning(info.pid)) {
    console.log('Dashboard is not running.');
    return false;
  }
  try {
    process.kill(info.pid, 'SIGTERM');
    // Wait up to 2s for it to die
    for (let i = 0; i < 20; i++) {
      if (!isRunning(info.pid)) break;
      execSync('sleep 0.1');
    }
    if (isRunning(info.pid)) {
      process.kill(info.pid, 'SIGKILL');
    }
    try { unlinkSync(PID_FILE); } catch {}
    console.log(`Dashboard (pid ${info.pid}) stopped.`);
    return true;
  } catch (e) {
    console.error(`Failed to stop dashboard (pid ${info.pid}):`, e.message);
    return false;
  }
}

if (command === 'stop') {
  stopDashboard();
  process.exit(0);
}

if (command === 'status') {
  const info = readPid();
  if (info && isRunning(info.pid)) {
    console.log(`Dashboard running: pid=${info.pid} port=${info.port}`);
    console.log(`URL: http://localhost:${info.port}`);
  } else {
    console.log('Dashboard is not running.');
    if (info) {
      try { unlinkSync(PID_FILE); } catch {}
    }
  }
  process.exit(0);
}

if (command === 'restart') {
  stopDashboard();
  // Fall through to start
}

// 'start' or 'restart' — check if already running (for plain 'start')
if (command === 'start') {
  const info = readPid();
  if (info && isRunning(info.pid)) {
    console.log(`Dashboard already running: pid=${info.pid} port=${info.port}`);
    console.log(`Use 'gc-dashboard restart' to restart.`);
    process.exit(0);
  }
}

// --- Helpers ---

/** Strip the 6-char hash suffix from project_id to get the project name */
function projectName(projectId) {
  return projectId.replace(/-[a-f0-9]{6}$/, '');
}

/** List all projects (directories under events/) */
async function listProjects() {
  try {
    const entries = await readdir(EVENTS_DIR, { withFileTypes: true });
    const projects = [];
    for (const e of entries) {
      if (!e.isDirectory()) continue;
      const projectId = e.name;
      // Count sessions
      const pdir = path.join(EVENTS_DIR, projectId);
      const sessions = await readdir(pdir, { withFileTypes: true }).catch(() => []);
      const sessionCount = sessions.filter(s => s.isDirectory()).length;
      projects.push({ project_id: projectId, name: projectName(projectId), session_count: sessionCount });
    }
    return projects;
  } catch {
    return [];
  }
}

/** List sessions for a project with metadata from session.json */
async function listSessions(projectId) {
  const pdir = path.join(EVENTS_DIR, projectId);
  try {
    const entries = await readdir(pdir, { withFileTypes: true });
    const sessions = [];
    for (const e of entries) {
      if (!e.isDirectory()) continue;
      const sdir = path.join(pdir, e.name);
      const metaPath = path.join(sdir, 'session.json');
      let meta = { session_id: e.name, project_id: projectId };
      try {
        const raw = await readFile(metaPath, 'utf-8');
        const parsed = JSON.parse(raw);
        meta = { ...meta, ...parsed };
      } catch {
        // Count events as fallback
        const files = await readdir(sdir).catch(() => []);
        meta.event_count = files.filter(f => /^\d+\.json$/.test(f)).length;
      }
      sessions.push(meta);
    }
    // Sort by started_at descending (newest first)
    sessions.sort((a, b) => (b.started_at || '').localeCompare(a.started_at || ''));
    return sessions;
  } catch {
    return [];
  }
}

/** Read event files from a session, optionally starting from a sequence number */
async function readEvents(projectId, sessionId, fromSeq = 0) {
  const sdir = path.join(EVENTS_DIR, projectId, sessionId);
  try {
    const entries = await readdir(sdir);
    const eventFiles = entries
      .filter(f => /^\d+\.json$/.test(f))
      .map(f => ({ filename: f, sequence: parseInt(f.replace('.json', ''), 10) }))
      .filter(f => f.sequence > fromSeq)
      .sort((a, b) => a.sequence - b.sequence);

    const events = [];
    for (const ef of eventFiles) {
      try {
        const raw = await readFile(path.join(sdir, ef.filename), 'utf-8');
        const parsed = JSON.parse(raw);
        parsed._summary = generateEventSummary(parsed);
        events.push(parsed);
      } catch { /* skip corrupt */ }
    }
    return events;
  } catch {
    return [];
  }
}

// --- Usage tracking ---

const CLAUDE_PROJECTS_DIR = path.join(os.homedir(), '.claude', 'projects');

// Cache: key = "filepath:filesize" -> { sessions: Map<sessionId, sessionUsage> }
const usageCache = new Map();

/** Convert a project_dir (e.g. /home/meywd/GlobalContext) to Claude's dir name */
function toClaudeDir(projectDir) {
  return '-' + projectDir.replace(/^\//, '').replace(/\//g, '-');
}

/** Read project_dir from the first session.json found in a project's events dir */
async function getProjectDir(projectId) {
  const pdir = path.join(EVENTS_DIR, projectId);
  try {
    const entries = await readdir(pdir, { withFileTypes: true });
    for (const e of entries) {
      if (!e.isDirectory()) continue;
      const metaPath = path.join(pdir, e.name, 'session.json');
      try {
        const raw = await readFile(metaPath, 'utf-8');
        const parsed = JSON.parse(raw);
        if (parsed.project_dir) return parsed.project_dir;
      } catch { /* try next */ }
    }
  } catch { /* no events dir */ }
  return null;
}

/** Stream-parse a JSONL file and extract assistant usage entries */
async function parseTranscriptFile(filePath) {
  const sessions = new Map();
  const daily = new Map();

  return new Promise((resolve, reject) => {
    const stream = createReadStream(filePath, { encoding: 'utf-8' });
    const rl = createInterface({ input: stream, crlfDelay: Infinity });

    rl.on('line', (line) => {
      // Fast pre-filter: only parse lines that look like assistant entries
      if (!line.includes('"type":"assistant"') && !line.includes('"type": "assistant"')) return;

      try {
        const entry = JSON.parse(line);
        if (entry.type !== 'assistant') return;

        const usage = entry.message?.usage;
        if (!usage) return;

        const sessionId = entry.sessionId || 'unknown';
        const model = entry.message?.model || 'unknown';
        const timestamp = entry.timestamp || '';

        if (!sessions.has(sessionId)) {
          sessions.set(sessionId, {
            session_id: sessionId,
            api_calls: 0,
            input_tokens: 0,
            output_tokens: 0,
            cache_read_tokens: 0,
            cache_create_tokens: 0,
            model: model,
            started_at: timestamp,
            last_api_call_at: timestamp,
          });
        }

        const s = sessions.get(sessionId);
        s.api_calls++;
        s.input_tokens += usage.input_tokens || 0;
        s.output_tokens += usage.output_tokens || 0;
        s.cache_read_tokens += usage.cache_read_input_tokens || 0;
        s.cache_create_tokens += usage.cache_creation_input_tokens || 0;
        if (model !== 'unknown') s.model = model;
        if (!s.started_at || timestamp < s.started_at) s.started_at = timestamp;
        if (!s.last_api_call_at || timestamp > s.last_api_call_at) s.last_api_call_at = timestamp;

        // Aggregate daily data
        const dateKey = timestamp.slice(0, 10); // 'YYYY-MM-DD'
        if (dateKey && dateKey.length === 10) {
          if (!daily.has(dateKey)) {
            daily.set(dateKey, {
              input_tokens: 0,
              output_tokens: 0,
              cache_read_tokens: 0,
              cache_create_tokens: 0,
              api_calls: 0,
            });
          }
          const d = daily.get(dateKey);
          d.input_tokens += usage.input_tokens || 0;
          d.output_tokens += usage.output_tokens || 0;
          d.cache_read_tokens += usage.cache_read_input_tokens || 0;
          d.cache_create_tokens += usage.cache_creation_input_tokens || 0;
          d.api_calls++;
        }
      } catch { /* skip malformed line */ }
    });

    rl.on('close', () => resolve({ sessions, daily }));
    rl.on('error', (err) => reject(err));
    stream.on('error', (err) => reject(err));
  });
}

/** Get usage for a single JSONL file, using cache if file size unchanged */
async function getFileUsage(filePath) {
  try {
    const st = await stat(filePath);
    const cacheKey = filePath + ':' + st.size;

    if (usageCache.has(cacheKey)) {
      return usageCache.get(cacheKey);
    }

    const result = await parseTranscriptFile(filePath);
    usageCache.set(cacheKey, result);
    return result;
  } catch {
    return { sessions: new Map(), daily: new Map() };
  }
}

/** Get usage data for a single project */
async function getProjectUsage(projectId) {
  const projectDir = await getProjectDir(projectId);
  if (!projectDir) return null;

  const claudeDir = toClaudeDir(projectDir);
  const claudePath = path.join(CLAUDE_PROJECTS_DIR, claudeDir);

  let files;
  try {
    const entries = await readdir(claudePath);
    files = entries.filter(f => f.endsWith('.jsonl')).map(f => path.join(claudePath, f));
  } catch {
    return null;
  }

  // Aggregate all sessions and daily data across all transcript files
  const allSessions = new Map();
  const allDaily = new Map();

  // Parse files concurrently (limit concurrency to avoid fd exhaustion)
  const CONCURRENCY = 8;
  const fileResults = [];
  for (let i = 0; i < files.length; i += CONCURRENCY) {
    const chunk = files.slice(i, i + CONCURRENCY);
    const results = await Promise.all(chunk.map(f => getFileUsage(f)));
    fileResults.push(...results);
  }

  for (const fileResult of fileResults) {
    const fileSessions = fileResult.sessions || fileResult;
    const fileDaily = fileResult.daily || new Map();

    for (const [sid, usage] of fileSessions) {
      if (!allSessions.has(sid)) {
        allSessions.set(sid, { ...usage });
      } else {
        const existing = allSessions.get(sid);
        existing.api_calls += usage.api_calls;
        existing.input_tokens += usage.input_tokens;
        existing.output_tokens += usage.output_tokens;
        existing.cache_read_tokens += usage.cache_read_tokens;
        existing.cache_create_tokens += usage.cache_create_tokens;
        if (usage.model !== 'unknown') existing.model = usage.model;
        if (usage.started_at < existing.started_at) existing.started_at = usage.started_at;
        if (usage.last_api_call_at > existing.last_api_call_at) existing.last_api_call_at = usage.last_api_call_at;
      }
    }

    for (const [dateKey, dayUsage] of fileDaily) {
      if (!allDaily.has(dateKey)) {
        allDaily.set(dateKey, { ...dayUsage });
      } else {
        const existing = allDaily.get(dateKey);
        existing.input_tokens += dayUsage.input_tokens;
        existing.output_tokens += dayUsage.output_tokens;
        existing.cache_read_tokens += dayUsage.cache_read_tokens;
        existing.cache_create_tokens += dayUsage.cache_create_tokens;
        existing.api_calls += dayUsage.api_calls;
      }
    }
  }

  const sessions = Array.from(allSessions.values())
    .sort((a, b) => (b.last_api_call_at || '').localeCompare(a.last_api_call_at || ''));

  const totals = {
    api_calls: 0,
    input_tokens: 0,
    output_tokens: 0,
    cache_read_tokens: 0,
    cache_create_tokens: 0,
  };

  const now = new Date();
  const weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
  const weekly = {
    input_tokens: 0,
    output_tokens: 0,
    cache_read_tokens: 0,
    cache_create_tokens: 0,
  };

  for (const s of sessions) {
    totals.api_calls += s.api_calls;
    totals.input_tokens += s.input_tokens;
    totals.output_tokens += s.output_tokens;
    totals.cache_read_tokens += s.cache_read_tokens;
    totals.cache_create_tokens += s.cache_create_tokens;

    // Weekly aggregation: check if session had activity this week
    if (s.last_api_call_at && new Date(s.last_api_call_at) >= weekAgo) {
      weekly.input_tokens += s.input_tokens;
      weekly.output_tokens += s.output_tokens;
      weekly.cache_read_tokens += s.cache_read_tokens;
      weekly.cache_create_tokens += s.cache_create_tokens;
    }
  }

  const byModel = {};
  for (const s of sessions) {
    const model = s.model || 'unknown';
    if (!byModel[model]) byModel[model] = { input_tokens: 0, output_tokens: 0, cache_read_tokens: 0, cache_create_tokens: 0, api_calls: 0 };
    byModel[model].input_tokens += s.input_tokens;
    byModel[model].output_tokens += s.output_tokens;
    byModel[model].cache_read_tokens += s.cache_read_tokens;
    byModel[model].cache_create_tokens += s.cache_create_tokens;
    byModel[model].api_calls += s.api_calls;
  }

  // Build daily array sorted ascending by date
  const daily = Array.from(allDaily.entries())
    .map(([date, d]) => ({ date, ...d }))
    .sort((a, b) => a.date.localeCompare(b.date));

  // Build monthly aggregation from daily data
  const monthlyMap = new Map();
  for (const d of daily) {
    const monthKey = d.date.slice(0, 7); // 'YYYY-MM'
    if (!monthlyMap.has(monthKey)) {
      monthlyMap.set(monthKey, { input_tokens: 0, output_tokens: 0, cache_read_tokens: 0, cache_create_tokens: 0, api_calls: 0 });
    }
    const m = monthlyMap.get(monthKey);
    m.input_tokens += d.input_tokens;
    m.output_tokens += d.output_tokens;
    m.cache_read_tokens += d.cache_read_tokens;
    m.cache_create_tokens += d.cache_create_tokens;
    m.api_calls += d.api_calls;
  }
  const monthly = Array.from(monthlyMap.entries())
    .map(([month, m]) => ({ month, ...m }))
    .sort((a, b) => a.month.localeCompare(b.month));

  return {
    project_id: projectId,
    project_name: projectName(projectId),
    claude_dir: claudeDir,
    sessions,
    totals,
    weekly,
    by_model: byModel,
    daily,
    monthly,
  };
}

// --- Utilization API ---

// --- Dashboard config (server-side persistence) ---
const DASHBOARD_CONFIG_PATH = path.join(BASE, '.dashboard-config.json');

async function loadDashboardConfig() {
  try {
    const raw = await readFile(DASHBOARD_CONFIG_PATH, 'utf-8');
    return JSON.parse(raw);
  } catch {
    return {};
  }
}

async function saveDashboardConfig(config) {
  const existing = await loadDashboardConfig();
  const merged = { ...existing, ...config };
  await writeFile(DASHBOARD_CONFIG_PATH, JSON.stringify(merged, null, 2) + '\n');
  return merged;
}

let utilizationCache = { data: null, fetchedAt: 0 };

async function fetchUtilization() {
  const now = Date.now();
  if (utilizationCache.data && (now - utilizationCache.fetchedAt) < 60_000) {
    return utilizationCache.data;
  }

  try {
    const credPath = path.join(os.homedir(), '.claude', '.credentials.json');
    const raw = await readFile(credPath, 'utf-8');
    const creds = JSON.parse(raw);
    const token = creds?.claudeAiOauth?.accessToken;

    if (!token) {
      const result = { available: false, error: 'No access token found' };
      utilizationCache = { data: result, fetchedAt: now };
      return result;
    }

    const data = await new Promise((resolve, reject) => {
      const req = https.get('https://api.anthropic.com/api/oauth/usage', {
        headers: {
          'Authorization': 'Bearer ' + token,
          'Accept': 'application/json',
        },
      }, (res) => {
        let body = '';
        res.on('data', chunk => { body += chunk; });
        res.on('end', () => {
          try {
            if (res.statusCode !== 200) {
              resolve({ available: false, error: 'HTTP ' + res.statusCode + ': ' + body.slice(0, 200) });
              return;
            }
            const parsed = JSON.parse(body);
            resolve({
              available: true,
              five_hour: {
                utilization: parsed.five_hour?.utilization ?? parsed.fiveHour?.utilization ?? null,
                resets_at: parsed.five_hour?.resets_at ?? parsed.fiveHour?.resetsAt ?? null,
              },
              seven_day: {
                utilization: parsed.seven_day?.utilization ?? parsed.sevenDay?.utilization ?? null,
                resets_at: parsed.seven_day?.resets_at ?? parsed.sevenDay?.resetsAt ?? null,
              },
            });
          } catch (e) {
            resolve({ available: false, error: 'Parse error: ' + e.message });
          }
        });
      });

      req.on('error', (e) => {
        resolve({ available: false, error: 'Request error: ' + e.message });
      });

      req.setTimeout(10_000, () => {
        req.destroy();
        resolve({ available: false, error: 'Request timeout' });
      });
    });

    utilizationCache = { data, fetchedAt: now };
    return data;
  } catch (e) {
    const result = { available: false, error: e.message };
    utilizationCache = { data: result, fetchedAt: now };
    return result;
  }
}

// --- HTTP server ---

function sendJson(res, data, status = 200) {
  const body = JSON.stringify(data);
  res.writeHead(status, {
    'Content-Type': 'application/json',
    'Access-Control-Allow-Origin': '*',
    'Cache-Control': 'no-cache',
  });
  res.end(body);
}

function send404(res) {
  sendJson(res, { error: 'not found' }, 404);
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, `http://${req.headers.host}`);
  const pathname = url.pathname;

  try {
    // --- API routes ---
    if (pathname === '/api/projects') {
      const projects = await listProjects();
      return sendJson(res, projects);
    }

    if (pathname === '/api/sessions') {
      const projectId = url.searchParams.get('project');
      if (!projectId) return sendJson(res, { error: 'project param required' }, 400);
      const sessions = await listSessions(projectId);
      return sendJson(res, sessions);
    }

    if (pathname === '/api/events') {
      const projectId = url.searchParams.get('project');
      const sessionId = url.searchParams.get('session');
      const from = parseInt(url.searchParams.get('from') || '0', 10);
      if (!projectId || !sessionId) return sendJson(res, { error: 'project and session params required' }, 400);
      const events = await readEvents(projectId, sessionId, from);
      return sendJson(res, events);
    }

    // --- Dashboard config API ---
    if (pathname === '/api/config') {
      if (req.method === 'POST' || req.method === 'PUT') {
        let body = '';
        for await (const chunk of req) body += chunk;
        try {
          const updates = JSON.parse(body);
          const config = await saveDashboardConfig(updates);
          return sendJson(res, config);
        } catch {
          return sendJson(res, { error: 'Invalid JSON' }, 400);
        }
      }
      const config = await loadDashboardConfig();
      return sendJson(res, config);
    }

    // --- Utilization API ---
    if (pathname === '/api/usage/utilization') {
      const util = await fetchUtilization();
      // Merge server-side config (weekly_limit) into response
      const config = await loadDashboardConfig();
      util.weekly_limit = config.weekly_limit || 0;
      return sendJson(res, util);
    }

    // --- Usage API ---
    if (pathname === '/api/usage') {
      const projectId = url.searchParams.get('project');
      if (projectId) {
        const usage = await getProjectUsage(projectId);
        if (!usage) return sendJson(res, { error: 'project not found or no transcript data' }, 404);
        return sendJson(res, usage);
      }
      // All projects — fetch in parallel
      const projects = await listProjects();
      const usageResults = await Promise.all(
        projects.map(p => getProjectUsage(p.project_id))
      );
      const results = usageResults.filter(Boolean);
      return sendJson(res, results);
    }

    // --- SSE stream ---
    if (pathname === '/api/stream') {
      const projectId = url.searchParams.get('project');
      const sessionId = url.searchParams.get('session');
      if (!projectId || !sessionId) return sendJson(res, { error: 'project and session params required' }, 400);

      // Disable Node.js response buffering for SSE
      res.socket.setNoDelay(true);
      res.writeHead(200, {
        'Content-Type': 'text/event-stream',
        'Cache-Control': 'no-cache',
        'Connection': 'keep-alive',
        'Access-Control-Allow-Origin': '*',
        'X-Accel-Buffering': 'no',
      });
      res.flushHeaders();

      let lastSeq = parseInt(url.searchParams.get('from') || '0', 10);
      let alive = true;

      req.on('close', () => { alive = false; });

      // Send initial keepalive
      res.write(':ok\n\n');

      const poll = async () => {
        if (!alive) return;
        try {
          const events = await readEvents(projectId, sessionId, lastSeq);
          for (const event of events) {
            if (!alive) return;
            res.write(`data: ${JSON.stringify(event)}\n\n`);
            if (event.sequence > lastSeq) lastSeq = event.sequence;
          }
        } catch { /* ignore errors, keep polling */ }
        if (alive) setTimeout(poll, 2000);
      };

      poll();
      return;
    }

    // --- Dashboard HTML ---
    if (pathname === '/' || pathname === '/index.html') {
      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
      res.end(DASHBOARD_HTML);
      return;
    }

    send404(res);
  } catch (err) {
    console.error('Request error:', err);
    sendJson(res, { error: 'internal error' }, 500);
  }
});

// Write PID file so hooks can detect if dashboard is running
function writePid() {
  try { writeFileSync(PID_FILE, `${process.pid}\n${port}\n`); } catch {}
}

function removePid() {
  try { unlinkSync(PID_FILE); } catch {}
}

process.on('SIGINT', () => { removePid(); process.exit(0); });
process.on('SIGTERM', () => { removePid(); process.exit(0); });
process.on('exit', removePid);

server.listen(port, () => {
  writePid();
  // Mark dashboard as enabled so deploy.sh can auto-start after updates
  try { writeFileSync(path.join(BASE, '.dashboard-enabled'), `${port}\n`); } catch {}
  console.log(`GlobalContext Dashboard running at http://localhost:${port}`);
  console.log(`Data directory: ${BASE}`);

  // Pre-warm usage cache in background (avoids slow first load)
  listProjects().then(projects =>
    Promise.all(projects.map(p => getProjectUsage(p.project_id).catch(() => null)))
  ).then(() => console.log('Usage cache warmed')).catch(() => {});
});


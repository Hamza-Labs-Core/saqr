  sessions: [],
  events: [],
  selectedProject: null,
  selectedSession: null,
  streaming: false,
  eventSource: null,
  autoScroll: true,
};

const $ = id => document.getElementById(id);

// --- API ---
async function api(path) {
  const res = await fetch(path);
  return res.json();
}

// --- Render ---
function renderProjects() {
  const el = $('projectList');
  el.innerHTML = state.projects.map(p =>
    '<div class="sidebar-item' + (state.selectedProject === p.project_id ? ' active' : '') + '" data-pid="' + p.project_id + '">' +
      '<span class="name">' + esc(p.name) + '</span>' +
      '<span class="count">' + p.session_count + '</span>' +
    '</div>'
  ).join('');

  el.querySelectorAll('.sidebar-item').forEach(item => {
    item.onclick = () => selectProject(item.dataset.pid);
  });
}

function renderSessions() {
  const el = $('sessionList');
  $('sessionsLabel').style.display = state.sessions.length ? '' : 'none';

  el.innerHTML = state.sessions.map(s => {
    const sid = s.session_id || '';
    const shortSid = sid.length > 20 ? sid.slice(0, 8) + '...' + sid.slice(-8) : sid;
    const count = s.event_count || 0;
    const started = s.started_at ? new Date(s.started_at).toLocaleTimeString() : '';
    const ended = s.ended_at ? ' (ended)' : '';
    const active = state.selectedSession === sid;

    return '<div class="session-item' + (active ? ' active' : '') + '" data-sid="' + sid + '">' +
      '<div class="sid">' + esc(shortSid) + '</div>' +
      '<div class="smeta">' + count + ' events &middot; ' + started + ended + '</div>' +
    '</div>';
  }).join('');

  el.querySelectorAll('.session-item').forEach(item => {
    item.onclick = () => selectSession(item.dataset.sid);
  });
}

function renderSessionHeader() {
  const el = $('sessionHeader');
  if (!state.selectedSession) {
    el.innerHTML = '<span class="label">Select a project and session</span>';
    return;
  }

  const s = state.sessions.find(s => s.session_id === state.selectedSession);
  if (!s) return;

  const isActive = !s.ended_at;
  const proj = state.selectedProject ? state.selectedProject.replace(/-[a-f0-9]{6}$/, '') : '';

  el.innerHTML =
    '<span class="badge ' + (isActive ? 'active' : 'ended') + '">' + (isActive ? 'LIVE' : 'ENDED') + '</span>' +
    '<span><span class="label">Project: </span><span class="value">' + esc(proj) + '</span></span>' +
    '<span><span class="label">Events: </span><span class="value">' + (s.event_count || state.events.length) + '</span></span>' +
    (s.last_prompt ? '<span><span class="label">Last: </span><span class="value">' + esc(truncStr(s.last_prompt, 60)) + '</span></span>' : '');
}

function renderEvents() {
  const el = $('eventFeed');
  if (!state.events.length) {
    el.innerHTML = '<div class="empty-state"><span>No events in this session</span></div>';
    return;
  }

  let html = '<table><thead><tr>' +
    '<th class="col-seq">#</th>' +
    '<th class="col-time">Time</th>' +
    '<th class="col-project">Project</th>' +
    '<th class="col-type">Event</th>' +
    '<th class="col-summary">Detail</th>' +
    '</tr></thead><tbody>';

  for (const e of state.events) {
    const ts = e.timestamp ? e.timestamp.slice(11, 19) : '';
    const proj = (e.project_id || '').replace(/-[a-f0-9]{6}$/, '');
    const etypeClass = 'etype-' + (e.event_type || '');
    const summary = e._summary || {};
    const summaryHtml = typeof summary === 'object' ? (summary.html || esc(summary.text || '')) : esc(summary);
    const rowClass = e.event_type === 'ToolCallFailed' ? ' class="ev-row-error"' : '';
    html += '<tr' + rowClass + '>' +
      '<td class="col-seq">' + (e.sequence || '') + '</td>' +
      '<td class="col-time">' + ts + '</td>' +
      '<td class="col-project">' + esc(proj) + '</td>' +
      '<td class="col-type"><span class="etype ' + etypeClass + '">' + esc(e.event_type || '') + '</span></td>' +
      '<td class="col-summary">' + summaryHtml + '</td>' +
      '</tr>';
  }

  html += '</tbody></table>';
  el.innerHTML = html;

  if (state.autoScroll) {
    el.scrollTop = el.scrollHeight;
  }
}

function appendEvent(event) {
  state.events.push(event);

  const el = $('eventFeed');
  let tbody = el.querySelector('tbody');

  if (!tbody) {
    renderEvents();
    return;
  }

  const ts = event.timestamp ? event.timestamp.slice(11, 19) : '';
  const proj = (event.project_id || '').replace(/-[a-f0-9]{6}$/, '');
  const etypeClass = 'etype-' + (event.event_type || '');
  const summary = event._summary || {};
  const summaryHtml = typeof summary === 'object' ? (summary.html || esc(summary.text || '')) : esc(summary);
  const tr = document.createElement('tr');
  tr.className = 'new' + (event.event_type === 'ToolCallFailed' ? ' ev-row-error' : '');
  tr.innerHTML =
    '<td class="col-seq">' + (event.sequence || '') + '</td>' +
    '<td class="col-time">' + ts + '</td>' +
    '<td class="col-project">' + esc(proj) + '</td>' +
    '<td class="col-type"><span class="etype ' + etypeClass + '">' + esc(event.event_type || '') + '</span></td>' +
    '<td class="col-summary">' + summaryHtml + '</td>';

  tbody.appendChild(tr);

  // Update header event count
  renderSessionHeader();

  if (state.autoScroll) {
    el.scrollTop = el.scrollHeight;
  }
}

// --- Actions ---
async function loadProjects() {
  state.projects = await api('/api/projects');
  renderProjects();
}

async function selectProject(projectId) {
  state.selectedProject = projectId;
  state.selectedSession = null;
  state.events = [];
  stopStream();
  renderProjects();
  renderEvents();
  renderSessionHeader();

  state.sessions = await api('/api/sessions?project=' + encodeURIComponent(projectId));
  renderSessions();

  // Auto-select the latest session
  if (state.sessions.length > 0) {
    selectSession(state.sessions[0].session_id);
  }
}

async function selectSession(sessionId) {
  state.selectedSession = sessionId;
  stopStream();
  renderSessions();

  // Load existing events
  state.events = await api('/api/events?project=' + encodeURIComponent(state.selectedProject) + '&session=' + encodeURIComponent(sessionId));
  renderEvents();
  renderSessionHeader();

  // Start SSE stream
  startStream();
}

function startStream() {
  stopStream();
  if (!state.selectedProject || !state.selectedSession) return;

  const lastSeq = state.events.length ? state.events[state.events.length - 1].sequence : 0;
  const url = '/api/stream?project=' + encodeURIComponent(state.selectedProject) +
    '&session=' + encodeURIComponent(state.selectedSession) +
    '&from=' + lastSeq;

  const es = new EventSource(url);
  state.eventSource = es;
  state.streaming = true;

  $('statusDot').className = 'dot live';
  $('statusText').textContent = 'Streaming';

  es.onmessage = (e) => {
    try {
      const event = JSON.parse(e.data);
      // Dedup: don't add if we already have this sequence
      if (state.events.some(ev => ev.sequence === event.sequence)) return;
      appendEvent(event);
    } catch {}
  };

  es.onerror = () => {
    $('statusDot').className = 'dot';
    $('statusText').textContent = 'Reconnecting...';
  };

  es.onopen = () => {
    $('statusDot').className = 'dot live';
    $('statusText').textContent = 'Streaming';
  };
}

function stopStream() {
  if (state.eventSource) {
    state.eventSource.close();
    state.eventSource = null;
  }
  state.streaming = false;
  $('statusDot').className = 'dot';
  $('statusText').textContent = 'Idle';
}

// --- Auto-scroll detection ---
$('eventFeed').addEventListener('scroll', () => {
  const el = $('eventFeed');
  state.autoScroll = (el.scrollHeight - el.scrollTop - el.clientHeight) < 40;
});

// --- Utils ---
function esc(s) {
  if (!s) return '';
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function truncStr(s, n) {
  if (!s || s.length <= n) return s || '';
  return s.slice(0, n) + '...';
}

// --- View switching ---
let currentView = 'events';

function switchView(view) {
  currentView = view;
  const eventsEls = [$('eventFeed'), $('sessionHeader')];
  const usageEl = $('usageView');
  const sidebarEl = $('sidebar');
  const layout = document.querySelector('.layout');

  $('tabEvents').className = 'header-tab' + (view === 'events' ? ' active' : '');
  $('tabUsage').className = 'header-tab' + (view === 'usage' ? ' active' : '');

  if (view === 'usage') {
    eventsEls.forEach(el => el.style.display = 'none');
    usageEl.classList.add('visible');
    sidebarEl.style.display = 'none';
    layout.classList.add('full-width');
    loadUsageData();
  } else {
    eventsEls.forEach(el => el.style.display = '');
    usageEl.classList.remove('visible');
    sidebarEl.style.display = '';
    layout.classList.remove('full-width');
  }
}

// --- Usage ---
let usageData = null;
let usageExpanded = {};
let usageSelectedMonth = null; // null = all time, 'YYYY-MM' = filter to month

const MODEL_PRICING = {
  'opus': { input: 15, output: 75, cache_read: 1.5, cache_create: 18.75 },
  'sonnet': { input: 3, output: 15, cache_read: 0.3, cache_create: 3.75 },
  'haiku': { input: 0.8, output: 4, cache_read: 0.08, cache_create: 1 },
};

function getModelTier(model) {
  if (!model) return 'opus';
  const m = model.toLowerCase();
  if (m.includes('haiku')) return 'haiku';
  if (m.includes('sonnet')) return 'sonnet';
  return 'opus';
}

function getModelColorClass(model) {
  if (!model || model === 'unknown') return 'unknown';
  const m = model.toLowerCase();
  if (m.includes('haiku')) return 'haiku';
  if (m.includes('sonnet')) return 'sonnet';
  if (m.includes('opus')) return 'opus';
  return 'unknown';
}

function calcCost(input, output, cacheRead, cacheCreate, model) {
  const tier = getModelTier(model);
  const p = MODEL_PRICING[tier];
  return (
    (input / 1_000_000) * p.input +
    (output / 1_000_000) * p.output +
    (cacheRead / 1_000_000) * p.cache_read +
    (cacheCreate / 1_000_000) * p.cache_create
  );
}

function calcProjectCost(proj) {
  let cost = 0;
  for (const s of proj.sessions) {
    cost += calcCost(s.input_tokens, s.output_tokens, s.cache_read_tokens, s.cache_create_tokens, s.model);
  }
  return cost;
}

function formatTokens(n) {
  if (n === 0) return '0';
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
  return n.toString();
}

function formatCost(c) {
  if (c >= 100) return '$' + c.toFixed(0);
  if (c >= 10) return '$' + c.toFixed(1);
  return '$' + c.toFixed(2);
}

function costClass(c) {
  if (c >= 50) return 'usage-cost very-high';
  if (c >= 10) return 'usage-cost high';
  return 'usage-cost';
}


let utilizationData = null;

async function loadUsageData() {
  const el = $('usageView');
  el.innerHTML = '<div class="usage-loading">Loading usage data...</div>';

  try {
    const [usage, util] = await Promise.all([
      api('/api/usage'),
      api('/api/usage/utilization').catch(() => ({ available: false })),
    ]);
    usageData = usage;
    utilizationData = util;
    renderUsage();
  } catch (err) {
    el.innerHTML = '<div class="usage-loading">Failed to load usage data</div>';
  }
}

function renderUsage() {
  const el = $('usageView');
  if (!usageData || !usageData.length) {
    el.innerHTML = '<div class="empty-state"><span>No usage data available</span><span class="hint">No Claude transcript files found for tracked projects</span></div>';
    return;
  }

  // Calculate weekly totals across all projects
  const weeklyTotals = { input_tokens: 0, output_tokens: 0, cache_read_tokens: 0, cache_create_tokens: 0 };
  let weeklyCost = 0;
  for (const p of usageData) {
    weeklyTotals.input_tokens += p.weekly.input_tokens;
    weeklyTotals.output_tokens += p.weekly.output_tokens;
    weeklyTotals.cache_read_tokens += p.weekly.cache_read_tokens;
    weeklyTotals.cache_create_tokens += p.weekly.cache_create_tokens;
    // Weekly cost per-session (only sessions with activity this week)
    const now = new Date();
    const weekAgo = new Date(now.getTime() - 7*24*60*60*1000);
    for (const s of p.sessions) {
      if (s.last_api_call_at && new Date(s.last_api_call_at) >= weekAgo) {
        weeklyCost += calcCost(s.input_tokens, s.output_tokens, s.cache_read_tokens, s.cache_create_tokens, s.model);
      }
    }
  }


  let html = '';

  // --- Daily Usage Timeline (last 30 days) ---
  // Aggregate daily data across all projects
  const dailyAgg = {};
  for (const p of usageData) {
    if (p.daily) {
      for (const d of p.daily) {
        if (!dailyAgg[d.date]) {
          dailyAgg[d.date] = { input_tokens: 0, output_tokens: 0, cache_read_tokens: 0, cache_create_tokens: 0, api_calls: 0 };
        }
        dailyAgg[d.date].input_tokens += d.input_tokens;
        dailyAgg[d.date].output_tokens += d.output_tokens;
        dailyAgg[d.date].cache_read_tokens += d.cache_read_tokens;
        dailyAgg[d.date].cache_create_tokens += d.cache_create_tokens;
        dailyAgg[d.date].api_calls += d.api_calls;
      }
    }
  }

  // Build last 30 days array
  const today = new Date();
  const last30 = [];
  for (let i = 29; i >= 0; i--) {
    const dt = new Date(today);
    dt.setDate(dt.getDate() - i);
    const key = dt.toISOString().slice(0, 10);
    const dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const label = dayNames[dt.getDay()] + ' ' + monthNames[dt.getMonth()] + ' ' + dt.getDate();
    const data = dailyAgg[key] || null;
    const total = data ? (data.input_tokens + data.output_tokens + data.cache_read_tokens + data.cache_create_tokens) : 0;
    last30.push({ date: key, label, total, data });
  }

  const maxDayTokens = Math.max(1, ...last30.map(d => d.total));

  html += '<div class="usage-section timeline-section">';
  html += '<div class="usage-section-title">Daily Usage <span class="tag">30 days</span></div>';
  html += '<div class="timeline-chart">';
  for (const day of last30) {
    const pct = day.total > 0 ? ((day.total / maxDayTokens) * 100).toFixed(1) : '0';
    const barClass = day.total > 0 ? 'timeline-bar' : 'timeline-bar empty';
    html += '<div class="timeline-row">' +
      '<span class="timeline-date">' + esc(day.label) + '</span>' +
      '<div class="timeline-bar-bg"><div class="' + barClass + '" style="width:' + pct + '%"></div></div>' +
      '<span class="timeline-value">' + (day.total > 0 ? formatTokens(day.total) : '-') + '</span>' +
      '</div>';
  }
  html += '</div>'; // timeline-chart
  html += '</div>'; // usage-section

  // Weekly summary cards
  html += '<div class="usage-section">';
  html += '<div class="usage-section-title">This Week <span class="tag">7 days</span></div>';
  html += '<div class="weekly-cards">';

  html += '<div class="weekly-card">' +
    '<div class="wc-label">Input Tokens</div>' +
    '<div class="wc-value">' + formatTokens(weeklyTotals.input_tokens) + '</div>' +
    '</div>';

  html += '<div class="weekly-card">' +
    '<div class="wc-label">Output Tokens</div>' +
    '<div class="wc-value">' + formatTokens(weeklyTotals.output_tokens) + '</div>' +
    '</div>';

  html += '<div class="weekly-card">' +
    '<div class="wc-label">Cache Read</div>' +
    '<div class="wc-value">' + formatTokens(weeklyTotals.cache_read_tokens) + '</div>' +
    '</div>';

  html += '<div class="weekly-card">' +
    '<div class="wc-label">Cache Create</div>' +
    '<div class="wc-value">' + formatTokens(weeklyTotals.cache_create_tokens) + '</div>' +
    '</div>';

  html += '<div class="weekly-card">' +
    '<div class="wc-label">Est. Cost</div>' +
    '<div class="wc-value ' + costClass(weeklyCost) + '">' + formatCost(weeklyCost) + '</div>' +
    '</div>';

  html += '</div>'; // weekly-cards

  // Utilization bars (from Anthropic API if available)
  if (utilizationData && utilizationData.available) {
    html += '<div class="utilization-section">';
    html += '<div class="usage-section-title" style="margin-top:12px">Rate Limit Utilization</div>';

    const fiveHour = utilizationData.five_hour;
    const sevenDay = utilizationData.seven_day;

    if (fiveHour && fiveHour.utilization != null) {
      const pct5 = (fiveHour.utilization * 100);
      const barCls5 = pct5 > 80 ? 'red' : pct5 > 50 ? 'yellow' : 'green';
      const reset5 = fiveHour.resets_at ? new Date(fiveHour.resets_at).toLocaleTimeString() : '';
      html += '<div class="util-row">' +
        '<span class="util-label">5-Hour Window:</span>' +
        '<div class="util-bar-bg"><div class="util-bar ' + barCls5 + '" style="width:' + Math.min(100, pct5).toFixed(1) + '%"></div></div>' +
        '<span class="util-pct">' + pct5.toFixed(0) + '%</span>' +
        (reset5 ? '<span class="util-reset">resets ' + esc(reset5) + '</span>' : '') +
        '</div>';
    }

    if (sevenDay && sevenDay.utilization != null) {
      const pct7 = (sevenDay.utilization * 100);
      const barCls7 = pct7 > 80 ? 'red' : pct7 > 50 ? 'yellow' : 'green';
      const reset7 = sevenDay.resets_at ? new Date(sevenDay.resets_at).toLocaleString() : '';
      html += '<div class="util-row">' +
        '<span class="util-label">7-Day Window:</span>' +
        '<div class="util-bar-bg"><div class="util-bar ' + barCls7 + '" style="width:' + Math.min(100, pct7).toFixed(1) + '%"></div></div>' +
        '<span class="util-pct">' + pct7.toFixed(0) + '%</span>' +
        (reset7 ? '<span class="util-reset">resets ' + esc(reset7) + '</span>' : '') +
        '</div>';
    }

    html += '</div>';
  }


  html += '</div>'; // usage-section

  // --- Month selector ---
  // Collect all available months from all projects
  const allMonthsSet = new Set();
  for (const p of usageData) {
    if (p.monthly) {
      for (const m of p.monthly) {
        allMonthsSet.add(m.month);
      }
    }
  }
  const allMonthsSorted = Array.from(allMonthsSet).sort().reverse();

  // Helper: check if a session falls within the selected month
  function sessionInMonth(s, month) {
    if (!month) return true; // all time
    const sa = (s.started_at || '').slice(0, 7);
    const la = (s.last_api_call_at || '').slice(0, 7);
    return sa === month || la === month;
  }

  // Filter sessions per project for the selected month
  function getFilteredSessions(p) {
    if (!usageSelectedMonth) return p.sessions;
    return p.sessions.filter(s => sessionInMonth(s, usageSelectedMonth));
  }

  if (allMonthsSorted.length > 1) {
    const mNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    html += '<div class="usage-section">';
    html += '<div class="usage-section-title">Filter by Month</div>';
    html += '<div class="month-selector">';
    html += '<button class="month-btn' + (!usageSelectedMonth ? ' active' : '') + '" data-month="">All Time</button>';
    for (const m of allMonthsSorted) {
      const [y, mo] = m.split('-');
      const label = mNames[parseInt(mo, 10) - 1] + ' ' + y;
      html += '<button class="month-btn' + (usageSelectedMonth === m ? ' active' : '') + '" data-month="' + m + '">' + esc(label) + '</button>';
    }
    html += '</div>';
    html += '</div>';
  }

  // Usage by Model table (filtered by month)
  const allModels = {};
  for (const p of usageData) {
    const filteredSessions = getFilteredSessions(p);
    for (const s of filteredSessions) {
      const model = s.model || 'unknown';
      if (!allModels[model]) allModels[model] = { input_tokens: 0, output_tokens: 0, cache_read_tokens: 0, cache_create_tokens: 0, api_calls: 0 };
      allModels[model].input_tokens += s.input_tokens;
      allModels[model].output_tokens += s.output_tokens;
      allModels[model].cache_read_tokens += s.cache_read_tokens;
      allModels[model].cache_create_tokens += s.cache_create_tokens;
      allModels[model].api_calls += s.api_calls;
    }
  }

  const modelEntries = Object.entries(allModels).sort((a, b) => {
    const costA = calcCost(a[1].input_tokens, a[1].output_tokens, a[1].cache_read_tokens, a[1].cache_create_tokens, a[0]);
    const costB = calcCost(b[1].input_tokens, b[1].output_tokens, b[1].cache_read_tokens, b[1].cache_create_tokens, b[0]);
    return costB - costA;
  });

  if (modelEntries.length > 0) {
    html += '<div class="usage-section">';
    html += '<div class="usage-section-title">Usage by Model <span class="tag">' + modelEntries.length + ' models</span></div>';
    html += '<table class="usage-table"><thead><tr>' +
      '<th>Model</th>' +
      '<th class="num">API Calls</th>' +
      '<th class="num">Input</th>' +
      '<th class="num">Output</th>' +
      '<th class="num">Cache Read</th>' +
      '<th class="num">Cache Create</th>' +
      '<th class="num">Est. Cost</th>' +
      '</tr></thead><tbody>';

    let modelTotalCost = 0;
    for (const [model, usage] of modelEntries) {
      const mCost = calcCost(usage.input_tokens, usage.output_tokens, usage.cache_read_tokens, usage.cache_create_tokens, model);
      modelTotalCost += mCost;
      const colorCls = getModelColorClass(model);
      html += '<tr>' +
        '<td><span class="model-dot model-dot-' + colorCls + '"></span><span class="model-name model-color-' + colorCls + '">' + esc(model) + '</span></td>' +
        '<td class="num">' + usage.api_calls + '</td>' +
        '<td class="num">' + formatTokens(usage.input_tokens) + '</td>' +
        '<td class="num">' + formatTokens(usage.output_tokens) + '</td>' +
        '<td class="num">' + formatTokens(usage.cache_read_tokens) + '</td>' +
        '<td class="num">' + formatTokens(usage.cache_create_tokens) + '</td>' +
        '<td class="num ' + costClass(mCost) + '">' + formatCost(mCost) + '</td>' +
        '</tr>';
    }

    html += '<tr class="totals-row">' +
      '<td>Total</td>' +
      '<td class="num">' + modelEntries.reduce((s, e) => s + e[1].api_calls, 0) + '</td>' +
      '<td class="num">' + formatTokens(modelEntries.reduce((s, e) => s + e[1].input_tokens, 0)) + '</td>' +
      '<td class="num">' + formatTokens(modelEntries.reduce((s, e) => s + e[1].output_tokens, 0)) + '</td>' +
      '<td class="num">' + formatTokens(modelEntries.reduce((s, e) => s + e[1].cache_read_tokens, 0)) + '</td>' +
      '<td class="num">' + formatTokens(modelEntries.reduce((s, e) => s + e[1].cache_create_tokens, 0)) + '</td>' +
      '<td class="num ' + costClass(modelTotalCost) + '">' + formatCost(modelTotalCost) + '</td>' +
      '</tr>';

    html += '</tbody></table>';
    html += '</div>'; // usage-section
  }

  // Per-project table (filtered by month)
  // First pass: compute totals for percentage calculation
  const projectStats = [];
  let grandTotal = { sessions: 0, input: 0, output: 0, cacheRead: 0, cacheCreate: 0, cost: 0, totalTokens: 0 };

  for (const p of usageData) {
    const filteredSessions = getFilteredSessions(p);
    if (usageSelectedMonth && filteredSessions.length === 0) continue;

    const projTotals = { input_tokens: 0, output_tokens: 0, cache_read_tokens: 0, cache_create_tokens: 0 };
    let projCost = 0;
    for (const s of filteredSessions) {
      projTotals.input_tokens += s.input_tokens;
      projTotals.output_tokens += s.output_tokens;
      projTotals.cache_read_tokens += s.cache_read_tokens;
      projTotals.cache_create_tokens += s.cache_create_tokens;
      projCost += calcCost(s.input_tokens, s.output_tokens, s.cache_read_tokens, s.cache_create_tokens, s.model);
    }
    const projTokens = projTotals.input_tokens + projTotals.output_tokens + projTotals.cache_read_tokens + projTotals.cache_create_tokens;

    grandTotal.sessions += filteredSessions.length;
    grandTotal.input += projTotals.input_tokens;
    grandTotal.output += projTotals.output_tokens;
    grandTotal.cacheRead += projTotals.cache_read_tokens;
    grandTotal.cacheCreate += projTotals.cache_create_tokens;
    grandTotal.cost += projCost;
    grandTotal.totalTokens += projTokens;

    projectStats.push({ p, filteredSessions, projTotals, projCost, projTokens });
  }

  // Second pass: render with percentages
  html += '<div class="usage-section">';
  html += '<div class="usage-section-title">All Projects <span class="tag">' + projectStats.length + ' projects</span></div>';

  html += '<table class="usage-table"><thead><tr>' +
    '<th></th>' +
    '<th>Project</th>' +
    '<th class="num">%</th>' +
    '<th class="num">Sessions</th>' +
    '<th class="num">Input</th>' +
    '<th class="num">Output</th>' +
    '<th class="num">Cache Read</th>' +
    '<th class="num">Cache Create</th>' +
    '<th class="num">Est. Cost</th>' +
    '</tr></thead><tbody>';

  for (const { p, filteredSessions, projTotals, projCost, projTokens } of projectStats) {
    const pct = grandTotal.totalTokens > 0 ? (projTokens / grandTotal.totalTokens * 100) : 0;
    const expanded = usageExpanded[p.project_id];

    html += '<tr>' +
      '<td><button class="expand-btn" data-pid="' + esc(p.project_id) + '">' + (expanded ? '[-]' : '[+]') + '</button></td>' +
      '<td class="project-name">' + esc(p.project_name) + '</td>' +
      '<td class="num"><span class="pct-badge">' + pct.toFixed(1) + '%</span></td>' +
      '<td class="num">' + filteredSessions.length + '</td>' +
      '<td class="num">' + formatTokens(projTotals.input_tokens) + '</td>' +
      '<td class="num">' + formatTokens(projTotals.output_tokens) + '</td>' +
      '<td class="num">' + formatTokens(projTotals.cache_read_tokens) + '</td>' +
      '<td class="num">' + formatTokens(projTotals.cache_create_tokens) + '</td>' +
      '<td class="num ' + costClass(projCost) + '">' + formatCost(projCost) + '</td>' +
      '</tr>';

    if (expanded) {
      for (const s of filteredSessions) {
        const sCost = calcCost(s.input_tokens, s.output_tokens, s.cache_read_tokens, s.cache_create_tokens, s.model);
        const shortSid = s.session_id.length > 20 ? s.session_id.slice(0,8) + '..' + s.session_id.slice(-6) : s.session_id;
        const timeStr = s.last_api_call_at ? s.last_api_call_at.slice(0,16).replace('T',' ') : '';
        html += '<tr class="session-detail-row">' +
          '<td></td>' +
          '<td>' + esc(shortSid) + ' <span style="color:var(--text2);font-size:10px">' + esc(s.model || '') + '</span> <span style="color:var(--text2);font-size:10px">' + timeStr + '</span></td>' +
          '<td></td>' +
          '<td class="num">' + s.api_calls + '</td>' +
          '<td class="num">' + formatTokens(s.input_tokens) + '</td>' +
          '<td class="num">' + formatTokens(s.output_tokens) + '</td>' +
          '<td class="num">' + formatTokens(s.cache_read_tokens) + '</td>' +
          '<td class="num">' + formatTokens(s.cache_create_tokens) + '</td>' +
          '<td class="num ' + costClass(sCost) + '">' + formatCost(sCost) + '</td>' +
          '</tr>';
      }
    }
  }

  // Grand total row
  html += '<tr class="totals-row">' +
    '<td></td>' +
    '<td>Total</td>' +
    '<td class="num">100%</td>' +
    '<td class="num">' + grandTotal.sessions + '</td>' +
    '<td class="num">' + formatTokens(grandTotal.input) + '</td>' +
    '<td class="num">' + formatTokens(grandTotal.output) + '</td>' +
    '<td class="num">' + formatTokens(grandTotal.cacheRead) + '</td>' +
    '<td class="num">' + formatTokens(grandTotal.cacheCreate) + '</td>' +
    '<td class="num ' + costClass(grandTotal.cost) + '">' + formatCost(grandTotal.cost) + '</td>' +
    '</tr>';

  html += '</tbody></table>';
  html += '</div>'; // usage-section

  el.innerHTML = html;

  // Bind expand buttons
  el.querySelectorAll('.expand-btn[data-pid]').forEach(btn => {
    btn.onclick = () => toggleProjectSessions(btn.dataset.pid);
  });

  // Bind monthly filter buttons
  el.querySelectorAll('.month-btn[data-month]').forEach(btn => {
    btn.onclick = () => {
      usageSelectedMonth = btn.dataset.month || null;
      renderUsage();
    };
  });

}

function toggleProjectSessions(projectId) {
  usageExpanded[projectId] = !usageExpanded[projectId];
  renderUsage();
}

// --- Init ---
loadProjects();

// Refresh project list every 30s
setInterval(loadProjects, 30000);

// Refresh session list every 10s (to catch new sessions)
setInterval(async () => {
  if (!state.selectedProject) return;
  const sessions = await api('/api/sessions?project=' + encodeURIComponent(state.selectedProject));
  state.sessions = sessions;
  renderSessions();
}, 10000);
</script>
</body>
</html>`;

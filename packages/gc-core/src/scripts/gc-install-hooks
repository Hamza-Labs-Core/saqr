#!/usr/bin/env bash
set -euo pipefail

# gc-install-hooks -- Hook lifecycle manager for GlobalContext
# Subcommands: install, uninstall, validate
# Manages GlobalContext hooks in ~/.claude/settings.json

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
HOOK_TIMEOUT=5000
HOOK_IDENTIFIER="gc-hook"
GC_HOOK_PATH="~/.claude-context/bin/gc-hook"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Resolve GC_BASE inline (not via paths.sh) because at install-time
# paths.sh may not yet be deployed to the target store.
GC_BASE="${CLAUDE_CONTEXT_PATH:-$HOME/.claude-context}"

# Resolve settings directory (uses HOME, can be overridden for testing)
CLAUDE_SETTINGS_DIR="${HOME}/.claude"
CLAUDE_SETTINGS_FILE="${CLAUDE_SETTINGS_DIR}/settings.json"

# Hook config file location: try next to this script first, then installed location
if [ -f "$SCRIPT_DIR/hook-config.json" ]; then
  HOOK_CONFIG="$SCRIPT_DIR/hook-config.json"
elif [ -f "$GC_BASE/lib/hook-config.json" ]; then
  HOOK_CONFIG="$GC_BASE/lib/hook-config.json"
elif [ -f "$GC_BASE/etc/hook-config.json" ]; then
  HOOK_CONFIG="$GC_BASE/etc/hook-config.json"
else
  HOOK_CONFIG=""
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() {
  echo "error: $*" >&2
  exit 1
}

info() {
  echo "$*"
}

# ---------------------------------------------------------------------------
# install subcommand
# ---------------------------------------------------------------------------
cmd_install() {
  # Pre-installation checks
  command -v jq >/dev/null 2>&1 || die "jq is required but not found on PATH"

  if [ ! -x "$GC_BASE/bin/capture-event" ]; then
    die "capture-event not found at $GC_BASE/bin/capture-event (run Story 01 install first)"
  fi

  if [ ! -x "$GC_BASE/bin/gc-hook" ]; then
    die "gc-hook not found at $GC_BASE/bin/gc-hook"
  fi

  [ -n "$HOOK_CONFIG" ] || die "hook-config.json not found"

  # Ensure ~/.claude/ directory exists
  if [ ! -d "$CLAUDE_SETTINGS_DIR" ]; then
    mkdir -p "$CLAUDE_SETTINGS_DIR"
    chmod 0700 "$CLAUDE_SETTINGS_DIR"
  fi

  # Read or initialize settings
  local settings_json='{}'
  local backup_path=""

  if [ -f "$CLAUDE_SETTINGS_FILE" ]; then
    # Validate existing JSON
    if ! jq . "$CLAUDE_SETTINGS_FILE" >/dev/null 2>&1; then
      die "Existing settings.json is malformed JSON: $CLAUDE_SETTINGS_FILE"
    fi
    # Create backup
    backup_path="${CLAUDE_SETTINGS_FILE}.bak.$(date +%Y%m%d-%H%M%S)"
    cp "$CLAUDE_SETTINGS_FILE" "$backup_path"
    settings_json=$(cat "$CLAUDE_SETTINGS_FILE")
  fi

  # Read hook config and merge into settings
  local hook_names
  hook_names=$(jq -r '.hooks | keys[]' "$HOOK_CONFIG")

  local current_json="$settings_json"

  for hook_name in $hook_names; do
    local event_type async_val timeout_val matcher_val
    event_type=$(jq -r ".hooks[\"$hook_name\"].event_type" "$HOOK_CONFIG")
    async_val=$(jq -r ".hooks[\"$hook_name\"].async" "$HOOK_CONFIG")
    timeout_val=$(jq -r ".hooks[\"$hook_name\"].timeout" "$HOOK_CONFIG")
    matcher_val=$(jq -r ".hooks[\"$hook_name\"].matcher" "$HOOK_CONFIG")

    # Build the command string
    local command_str="${GC_HOOK_PATH} ${event_type}"

    # Build the inner hook handler
    local hook_handler
    hook_handler=$(jq -n --arg cmd "$command_str" --argjson timeout "$timeout_val" \
      '{type: "command", command: $cmd, timeout: $timeout}')

    # Build the outer matcher group (nested format: {matcher?, hooks: [handler]})
    local matcher_group
    if [ "$matcher_val" != "null" ] && [ -n "$matcher_val" ]; then
      matcher_group=$(jq -n --arg matcher "$matcher_val" --argjson handler "$hook_handler" \
        '{matcher: $matcher, hooks: [$handler]}')
    else
      matcher_group=$(jq -n --argjson handler "$hook_handler" \
        '{hooks: [$handler]}')
    fi

    # Merge: remove old gc-hook matcher groups, append new one
    # A matcher group "belongs to gc-hook" if any of its inner hooks' commands contain the identifier
    current_json=$(echo "$current_json" | jq --argjson new_group "$matcher_group" --arg hook_name "$hook_name" --arg identifier "$HOOK_IDENTIFIER" \
      '.hooks = (.hooks // {}) |
       .hooks[$hook_name] = ([(.hooks[$hook_name] // [])[] | select(
         if .hooks then
           # Nested format: check inner hooks for gc-hook
           ([.hooks[] | select((.command // "") | contains($identifier))] | length) == 0
         else
           # Legacy flat format: check .command directly
           ((.command // "") | contains($identifier)) | not
         end
       )] + [$new_group])')
  done

  # Write with 2-space indentation
  echo "$current_json" | jq --indent 2 '.' > "$CLAUDE_SETTINGS_FILE"

  # Validate written file
  if ! jq . "$CLAUDE_SETTINGS_FILE" >/dev/null 2>&1; then
    die "Written settings.json is not valid JSON (this should not happen)"
  fi

  local msg="Installed 10 GlobalContext hooks."
  if [ -n "$backup_path" ]; then
    msg="$msg Backup: $backup_path"
  fi
  info "$msg"
}

# ---------------------------------------------------------------------------
# uninstall subcommand
# ---------------------------------------------------------------------------
cmd_uninstall() {
  command -v jq >/dev/null 2>&1 || die "jq is required but not found on PATH"

  if [ ! -f "$CLAUDE_SETTINGS_FILE" ]; then
    die "settings.json not found at $CLAUDE_SETTINGS_FILE"
  fi

  if ! jq . "$CLAUDE_SETTINGS_FILE" >/dev/null 2>&1; then
    die "settings.json is malformed JSON: $CLAUDE_SETTINGS_FILE"
  fi

  # Create backup
  local backup_path="${CLAUDE_SETTINGS_FILE}.bak.$(date +%Y%m%d-%H%M%S)"
  cp "$CLAUDE_SETTINGS_FILE" "$backup_path"

  # Remove all gc-hook entries from all hook arrays (handles nested format)
  local cleaned_json
  cleaned_json=$(jq --arg identifier "$HOOK_IDENTIFIER" '
    if .hooks then
      .hooks |= with_entries(
        .value |= [.[] | select(
          if .hooks then
            # Nested format: keep if no inner hooks contain identifier
            ([.hooks[] | select((.command // "") | contains($identifier))] | length) == 0
          else
            # Legacy flat format: keep if command does not contain identifier
            ((.command // "") | contains($identifier)) | not
          end
        )]
      ) |
      # Remove empty arrays
      .hooks |= with_entries(select(.value | length > 0)) |
      # Remove empty hooks object
      if (.hooks | length) == 0 then del(.hooks) else . end
    else
      .
    end
  ' "$CLAUDE_SETTINGS_FILE")

  echo "$cleaned_json" | jq --indent 2 '.' > "$CLAUDE_SETTINGS_FILE"

  info "Uninstalled GlobalContext hooks. Backup: $backup_path"
}

# ---------------------------------------------------------------------------
# validate subcommand
# ---------------------------------------------------------------------------
cmd_validate() {
  command -v jq >/dev/null 2>&1 || die "jq is required but not found on PATH"

  local all_pass=true

  # Check settings.json exists
  if [ ! -f "$CLAUDE_SETTINGS_FILE" ]; then
    echo "FAIL: settings.json not found at $CLAUDE_SETTINGS_FILE"
    exit 1
  fi

  if ! jq . "$CLAUDE_SETTINGS_FILE" >/dev/null 2>&1; then
    echo "FAIL: settings.json is malformed JSON"
    exit 1
  fi

  [ -n "$HOOK_CONFIG" ] || die "hook-config.json not found"

  # Check each of the 10 expected hooks
  local hook_names
  hook_names=$(jq -r '.hooks | keys[]' "$HOOK_CONFIG")

  for hook_name in $hook_names; do
    local event_type
    event_type=$(jq -r ".hooks[\"$hook_name\"].event_type" "$HOOK_CONFIG")

    # Check hook event key exists
    local has_key
    has_key=$(jq --arg hook_name "$hook_name" 'if .hooks[$hook_name] then "yes" else "no" end' "$CLAUDE_SETTINGS_FILE")

    if [ "$has_key" = '"no"' ]; then
      echo "FAIL: $hook_name -- not found in settings.json"
      all_pass=false
      continue
    fi

    # Check that at least one matcher group contains a gc-hook handler
    local gc_hook_count
    gc_hook_count=$(jq --arg hook_name "$hook_name" --arg identifier "$HOOK_IDENTIFIER" \
      '[.hooks[$hook_name][] | select(
        if .hooks then
          ([.hooks[] | select((.command // "") | contains($identifier))] | length) > 0
        else
          ((.command // "") | contains($identifier))
        end
      )] | length' "$CLAUDE_SETTINGS_FILE")

    if [ "$gc_hook_count" -eq 0 ]; then
      echo "FAIL: $hook_name -- no gc-hook entry found"
      all_pass=false
      continue
    fi

    # Extract the gc-hook handler from the nested matcher group
    local actual_timeout
    actual_timeout=$(jq --arg hook_name "$hook_name" --arg identifier "$HOOK_IDENTIFIER" \
      '[.hooks[$hook_name][] | select(
        if .hooks then
          ([.hooks[] | select((.command // "") | contains($identifier))] | length) > 0
        else
          ((.command // "") | contains($identifier))
        end
      )][0] | if .hooks then [.hooks[] | select((.command // "") | contains($identifier))][0].timeout else .timeout end' "$CLAUDE_SETTINGS_FILE")

    if [ "$actual_timeout" != "$HOOK_TIMEOUT" ]; then
      echo "FAIL: $hook_name -- timeout is $actual_timeout, expected $HOOK_TIMEOUT"
      all_pass=false
      continue
    fi

    # Verify matcher field matches config (matcher is on the outer group in nested format)
    local expected_matcher actual_matcher
    expected_matcher=$(jq -r ".hooks[\"$hook_name\"].matcher" "$HOOK_CONFIG")
    actual_matcher=$(jq -r --arg hook_name "$hook_name" --arg identifier "$HOOK_IDENTIFIER" \
      '[.hooks[$hook_name][] | select(
        if .hooks then
          ([.hooks[] | select((.command // "") | contains($identifier))] | length) > 0
        else
          ((.command // "") | contains($identifier))
        end
      )][0].matcher // "null"' "$CLAUDE_SETTINGS_FILE")

    # Normalize: empty string and null both mean "match all"
    local norm_expected="$expected_matcher"
    local norm_actual="$actual_matcher"
    [ "$norm_expected" = "" ] && norm_expected="null"
    [ "$norm_actual" = "" ] && norm_actual="null"

    if [ "$norm_expected" != "$norm_actual" ]; then
      echo "FAIL: $hook_name -- matcher is '$actual_matcher', expected '$expected_matcher'"
      all_pass=false
      continue
    fi

    echo "PASS: $hook_name ($event_type)"
  done

  # Check gc-hook is executable
  if [ -x "$GC_BASE/bin/gc-hook" ]; then
    echo "PASS: gc-hook is executable"
  else
    echo "FAIL: gc-hook is not executable at $GC_BASE/bin/gc-hook"
    all_pass=false
  fi

  # Smoke test
  echo ""
  echo "Running smoke test..."
  local smoke_output smoke_stderr_file smoke_exit
  smoke_stderr_file=$(mktemp)
  smoke_exit=0
  smoke_output=$(echo '{"session_id":"__gc_validation_test__","test":true}' | "$GC_BASE/bin/gc-hook" TestValidation 2>"$smoke_stderr_file") || smoke_exit=$?

  if [ "$smoke_exit" -eq 0 ]; then
    echo "PASS: smoke test exit code 0"
  else
    echo "FAIL: smoke test exit code $smoke_exit"
    all_pass=false
  fi

  if [ -z "$smoke_output" ]; then
    echo "PASS: smoke test produced no stdout"
  else
    echo "FAIL: smoke test produced stdout: $smoke_output"
    all_pass=false
  fi

  local smoke_stderr
  smoke_stderr=$(cat "$smoke_stderr_file")
  rm -f "$smoke_stderr_file"

  if [ -z "$smoke_stderr" ]; then
    echo "PASS: smoke test produced no stderr"
  else
    echo "FAIL: smoke test produced stderr: $smoke_stderr"
    all_pass=false
  fi

  # Clean up test session directory if it exists
  local test_session_dirs
  test_session_dirs=$(find "$GC_BASE/events" -type d -name "__gc_validation_test__" 2>/dev/null || true)
  if [ -n "$test_session_dirs" ]; then
    echo "$test_session_dirs" | while read -r dir; do
      rm -rf "$dir"
    done
  fi

  echo ""
  if [ "$all_pass" = true ]; then
    echo "Overall: PASS -- all checks passed"
    exit 0
  else
    echo "Overall: FAIL -- some checks failed"
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
usage() {
  echo "Usage: gc-install-hooks <install|uninstall|validate>"
  echo ""
  echo "Subcommands:"
  echo "  install    Install GlobalContext hooks into Claude Code settings"
  echo "  uninstall  Remove GlobalContext hooks from Claude Code settings"
  echo "  validate   Verify hooks are correctly installed"
  exit 1
}

case "${1:-}" in
  install)   cmd_install ;;
  uninstall) cmd_uninstall ;;
  validate)  cmd_validate ;;
  *)         usage ;;
esac

{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Saqr",
  "version": "0.1.0",
  "identifier": "dev.saqr.desktop",
  "build": {
    "beforeBuildCommand": "pnpm vite build --config frontend/vite.config.ts",
    "beforeDevCommand": "pnpm vite --config frontend/vite.config.ts",
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Saqr",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://tauri.localhost; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost ws://localhost:* wss://*.saqr.dev http://localhost:* https://*.saqr.dev https://*.workers.dev; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2024-2026 Hamza Labs. All rights reserved.",
    "shortDescription": "Multi-agent management desktop application",
    "longDescription": "Saqr — orchestrate, observe, and control AI coding agents from anywhere. Full desktop client with terminal-faithful UI, real-time event streaming, and multi-agent session management.",
    "category": "DeveloperTool",
    "publisher": "Hamza Labs",
    "homepage": "https://saqr.dev",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "devel"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Hamza-Labs-Core/saqr/releases/latest/download/latest.json"
      ],
      "pubkey": "<UPDATER_PUBLIC_KEY>"
    }
  }
}

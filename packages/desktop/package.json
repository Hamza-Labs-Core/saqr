{
  "name": "@saqr/desktop",
  "version": "0.1.0",
  "description": "Tauri 2 desktop app TypeScript IPC layer for AgentContext",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build && vite build --config frontend/vite.config.ts --outDir frontend/dist",
    "build:ipc": "tsc --build",
    "dev": "vite --config frontend/vite.config.ts",
    "dev:ipc": "tsc --build --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@saqr/shared": "workspace:*",
    "@saqr/terminal-ui": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ],
  "private": true,
  "license": "MIT"
}

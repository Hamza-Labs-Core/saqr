{
  "name": "@saqr/mobile",
  "version": "0.1.0",
  "description": "Saqr Mobile App - Expo/React Native agent management",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "clean": "rm -rf dist .expo android ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@saqr/shared": "workspace:*",
    "@saqr/terminal-ui": "workspace:*",
    "@tanstack/react-query": "^5.90.11",
    "expo": "^54.0.18",
    "expo-av": "^16.0.7",
    "expo-build-properties": "^1.0.9",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.9",
    "expo-crypto": "^15.0.8",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-notifications": "^0.32.16",
    "expo-router": "~6.0.13",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~31.0.10",
    "expo-system-ui": "~6.0.7",
    "lucide-react-native": "^0.546.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.14.0",
    "react-native-web": "~0.21.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2",
    "vitest": "^3.0.0"
  },
  "author": "Hamza Labs <hello@hamza.dev> (https://hamza.dev)",
  "license": "MIT"
}

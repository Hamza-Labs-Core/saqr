{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saqr-website",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client"
  },
  "main": "./worker-entry.js",
  "placement": {
    "mode": "smart"
  },
  // "routes": [
  //   { "pattern": "saqr.dev", "custom_domain": true },
  //   { "pattern": "www.saqr.dev", "custom_domain": true }
  // ],
  "vars": {
    "SYNC_SERVER_URL": "https://sync.saqr.dev",
    "ADMIN_SERVER_URL": "https://admin.saqr.dev"
  },
  "env": {
    "preview": {
      "name": "saqr-website-preview",
      "vars": {
        "SYNC_SERVER_URL": "https://saqr-sync-preview.workers.dev",
        "ADMIN_SERVER_URL": "https://saqr-admin-preview.workers.dev"
      }
    }
  }
}
